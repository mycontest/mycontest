<% if(typeof contest !== 'undefined' && contest) { %>
<ul class="nav nav-tabs mb-4">
  <li class="nav-item">
    <a class="nav-link <%= typeof page_info !== 'undefined' && page_info === 'contest' ? 'active' : '' %>" href="/contest/<%= contest.contest_id %>"> <i class="bi bi-info-circle me-1"></i> Ma'lumot </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= typeof page_info !== 'undefined' && (page_info === 'problems' || page_info === 'problem') ? 'active' : '' %>" href="/contest/<%= contest.contest_id %>/problems"> <i class="bi bi-file-earmark-code me-1"></i> Masalalar </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= typeof page_info !== 'undefined' && page_info === 'attempts' ? 'active' : '' %>" href="/contest/<%= contest.contest_id %>/attempts"> <i class="bi bi-clock-history me-1"></i> Urinishlar </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= typeof page_info !== 'undefined' && page_info === 'ratings' ? 'active' : '' %>" href="/contest/<%= contest.contest_id %>/rating"> <i class="bi bi-trophy me-1"></i> Natijalar </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= typeof page_info !== 'undefined' && page_info === 'participants' ? 'active' : '' %>" href="/contest/<%= contest.contest_id %>/participants"> <i class="bi bi-people me-1"></i> Ishtirokchilar </a>
  </li>
</ul>
<% } %>
