<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Ro'yxatdan o'tish — mycontest.dev</title>
    <%- include("../components/head.ejs") %>
  </head>
  <body class="bg-secondary">
    <%- include("../components/navbar.ejs") %>

    <div class="auth-wrapper">
      <div class="auth-card animate-slideUp" style="max-width: 420px">
        <div class="auth-header">
          <h1 class="auth-title">Hisob yaratish</h1>
          <p class="auth-subtitle">Platformaga qo'shiling va musobaqalarda qatnashing.</p>
        </div>

        <form method="post">
          <div class="form-group">
            <label class="form-label">To'liq ism</label>
            <input type="text" name="full_name" class="form-control" placeholder="Ism Familiya" required autofocus />
          </div>

          <div class="form-group">
            <label class="form-label">Foydalanuvchi nomi</label>
            <input type="text" name="username" class="form-control" placeholder="username" required />
            <p class="form-text">Faqat lotin harflari va raqamlar, 3-30 belgi.</p>
          </div>

          <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" placeholder="email@example.com" required />
            <p class="form-text">Tasdiqlash havolasi yuboriladi.</p>
          </div>

          <div class="form-group">
            <label class="form-label">Parol</label>
            <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            <p class="form-text">Kamida 6 ta belgi tavsiya etiladi.</p>
          </div>

          <button type="submit" class="btn btn-primary btn-md w-full mt-3">
            <i class="bi bi-person-plus"></i>
            Ro'yxatdan o'tish
          </button>
        </form>

        <div class="auth-footer">
          Allaqachon a'zomisiz?
          <a href="/sign-in">Kirish</a>
        </div>
      </div>
    </div>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
