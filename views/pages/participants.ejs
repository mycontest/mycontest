<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Ishtirokchilar — <%= contest.name %></title>
    <%- include("../components/head.ejs") %>
  </head>
  <body>
    <%- include("../components/navbar.ejs") %>

    <main style="padding: 16px 0 32px">
      <div class="container">
        <%- include("topbar.ejs") %>

        <div class="row g-3">
          <div class="col-12">
            <div class="card">
              <div style="padding: 16px; border-bottom: 1px solid var(--border-light)">
                <h3 style="font-size: 14px; font-weight: 600; margin: 0">Ishtirokchilar (<%= participants.length %>)</h3>
              </div>
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      <th style="width: 50px">#</th>
                      <th>Ism Familiya</th>
                      <th>Username</th>
                      <th>Qo'shilgan vaqt</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% participants.forEach((p, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= p.full_name %></td>
                      <td style="font-family: var(--font-mono); font-size: 12px; color: var(--primary)"><%= p.username %></td>
                      <td style="color: var(--text-muted); font-size: 12px"><%= new Date(p.created_dt).toLocaleString()%></td>
                    </tr>
                    <% }) %> <% if(participants.length === 0) { %>
                    <tr>
                      <td colspan="4" class="text-center text-muted" style="padding: 20px">Hozircha ishtirokchilar yo'q</td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
