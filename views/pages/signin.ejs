<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Kirish — mycontest.dev</title>
    <%- include("../components/head.ejs") %>
  </head>
  <body class="bg-secondary">
    <%- include("../components/navbar.ejs") %>

    <div class="auth-wrapper">
      <div class="auth-card animate-slideUp">
        <div class="auth-header">
          <h1 class="auth-title">Xush kelibsiz</h1>
          <p class="auth-subtitle">Platformaga kirish uchun ma'lumotlaringizni kiriting.</p>
        </div>

        <form method="post">
          <div class="form-group">
            <label class="form-label">Foydalanuvchi nomi</label>
            <input type="text" name="username" class="form-control" placeholder="username" required autocomplete="username" autofocus />
          </div>

          <div class="form-group">
            <label class="form-label">Parol</label>
            <input type="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password" />
          </div>

          <button type="submit" class="btn btn-primary btn-md w-full mt-3">
            <i class="bi bi-box-arrow-in-right"></i>
            Kirish
          </button>
        </form>

        <div class="auth-footer">
          Hisobingiz yo'qmi?
          <a href="/sign-up">Ro'yxatdan o'ting</a>
        </div>
      </div>
    </div>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
