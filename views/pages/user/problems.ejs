<ul class="task-list">
    <% if (problems && problems.length > 0) { %>
        <% problems.forEach(p => { %>
            <li class="task">
                <div style="flex: 1;">
                    <a href="/problems/<%= p.id %>" style="font-weight: bold; font-size: 1.1em; text-decoration: none;"><%= p.name %></a>
                    <div style="font-size: 0.85em; color: #666; margin-top: 4px;">
                        <span style="background: #eef2ff; color: #4f46e5; padding: 2px 6px; border-radius: 4px; margin-right: 5px;">
                            <%= p.points %> Points
                        </span>
                        <span style="background: #fdf2f8; color: #db2777; padding: 2px 6px; border-radius: 4px;">
                            Time: <%= p.time_ms %>ms
                        </span>
                    </div>
                </div>
                <!-- Placeholder for solved status -->
                <span class="task-score icon"></span>
            </li>
        <% }) %>
    <% } else { %>
        <li class="task" >No public problems found.</li>
    <% } %>
</ul>

 