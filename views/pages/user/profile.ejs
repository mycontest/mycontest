<div class="content">
  <h1>Profile</h1>

  <table class="narrow">
    <tbody>
      <tr>
        <th>Username</th>
        <td><%= user.username %></td>
      </tr>
      <tr>
        <th>Email</th>
        <td><%= user.email || 'N/A' %></td>
      </tr>
      <tr>
        <th>Name</th>
        <td><%= user.name %></td>
      </tr>
      <tr>
        <th>Role</th>
        <td><%= user.role %></td>
      </tr>
    </tbody>
  </table>
</div>
