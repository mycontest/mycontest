<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Masalalar: <%= contest.name %> — mycontest.dev</title>
    <%- include("../components/head.ejs") %>
  </head>
  <body>
    <%- include("../components/navbar.ejs") %>

    <main style="padding: 16px 0 32px">
      <div class="container">
        <%- include("topbar.ejs") %>

        <div class="card" style="padding: 0; overflow: hidden; margin-top: 16px">
          <div style="padding: 8px 14px; border-bottom: 1px solid var(--border-light); font-weight: 600; font-size: 13px">Masalalar ro'yxati</div>
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th style="width: 60px; text-align: center">ID</th>
                  <th>Masala nomi</th>
                  <th style="width: 120px; text-align: center">Holat</th>
                </tr>
              </thead>
              <tbody>
                <% if(tasks && tasks.length > 0) { %> <% tasks.forEach((t) => { %>
                <tr>
                  <td style="text-align: center"><%= t.task_id %></td>
                  <td><a href="/contest/<%= contest.contest_id %>/problem?task_id=<%= t.task_id %>" style="font-weight: 500"><%= t.name %></a></td>
                  <td style="text-align: center">
                    <% if(t.status == 1) { %>
                    <span>✅</span>
                    <% } else if(t.status > 1 && t.status < 10) { %>
                    <span>❌</span>
                    <% } else { %>
                    <span>-</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %> <% } else { %>
                <tr>
                  <td colspan="3" class="text-center p-4 text-muted">Masalalar mavjud emas</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
