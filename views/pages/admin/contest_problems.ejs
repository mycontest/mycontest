<h1>Manage Problems: <%= contest.name %></h1>

<div class="boxes">
    <div style="width: 60%;">
        <h3>Contest Problems</h3>
        <ul class="task-list">
            <% addedProblems.forEach(p => { %>
                <li class="task">
                    <span><%= p.name %></span>
                    <div class="samp-actions">
                        <form action="/admin/contests/<%= contest.id %>/problems" method="POST" style="display:inline;">
                            <input type="hidden" name="action" value="remove">
                            <input type="hidden" name="problem_id" value="<%= p.problem_id %>">
                            <button type="submit" class="delete icon" title="Remove"></button>
                        </form>
                    </div>
                </li>
            <% }) %>
        </ul>
    </div>
    <div style="width: 38%;">
        <h3>Add Problem</h3>
        <form action="/admin/contests/<%= contest.id %>/problems" method="POST" class="simple-form">
            <input type="hidden" name="action" value="add">
            <label>Problem</label>
            <select name="problem_id">
                <% allProblems.forEach(p => { %>
                    <option value="<%= p.id %>"><%= p.name %></option>
                <% }) %>
            </select>
            <input type="submit" value="Add" class="btn">
        </form>
    </div>
</div>
