<h1>Add Contest</h1>
<form action="/admin/contests/add" method="POST" class="simple-form" style="max-width: 600px">
  <label for="name">Name</label>
  <input type="text" name="name" id="name" required />

  <label for="content">Content (Description)</label>
  <textarea name="content" rows="5" id="content"></textarea>

  <label>Type</label>
  <select name="type">
    <option value="public">Public</option>
    <option value="private">Private</option>
  </select>

  <label for="start_date">Start Date</label>
  <input type="datetime-local" name="start_date" id="start_date" required />

  <label for="duration_min">Duration (Minutes)</label>
  <input type="number" name="duration_min" id="duration_min" value="120" required />

  <input type="submit" value="Create Contest" class="btn" />
</form>
