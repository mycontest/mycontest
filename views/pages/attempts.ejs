<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Urinishlar: <%= contest.name %> — mycontest.dev</title>
    <%- include("../components/head.ejs") %>
  </head>
  <body>
    <%- include("../components/navbar.ejs") %>

    <main style="padding: 16px 0 32px">
      <div class="container">
        <%- include("topbar.ejs") %>

        <div class="flex justify-between items-end mb-3">
          <div>
            <h1 class="mb-1">Barcha Urinishlar</h1>
            <p class="text-muted">Ishtirokchilarning yuborilgan yechimlari.</p>
          </div>
          <div class="flex items-center gap-2 text-muted text-sm">
            <i class="bi bi-arrow-repeat"></i>
            <span>5s yangilanadi</span>
          </div>
        </div>

        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th style="width: 70px; text-align: center">ID</th>
                <th>Ishtirokchi</th>
                <th style="width: 100px">Masala</th>
                <th style="width: 100px">Til</th>
                <th style="width: 140px">Holat</th>
                <th style="width: 80px; text-align: right">Vaqt</th>
                <th style="width: 80px; text-align: right">Xotira</th>
              </tr>
            </thead>
            <tbody id="data">
              <tr>
                <td colspan="7" style="text-align: center; padding: 48px; color: var(--text-muted)">
                  <div class="loader mx-auto mb-3"></div>
                  Yuklanmoqda...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="flex justify-end gap-2 mt-4">
          <button class="btn btn-md" onclick="setPage(-1)">
            <i class="bi bi-chevron-left"></i>
            Oldingi
          </button>
          <button class="btn btn-md" onclick="setPage(1)">
            Keyingi
            <i class="bi bi-chevron-right"></i>
          </button>
        </div>
      </div>
    </main>

    <%- include("../components/footer.ejs") %>

    <script>
      const contest_id = "<%= contest.contest_id %>";
      let current_page = 0;

      function setPage(inc) {
        current_page = Math.max(0, current_page + inc);
        loadAttempts();
      }

      function loadAttempts() {
        fetch(`/contest/${contest_id}/attempts/all?page=${current_page}`)
          .then((r) => r.json())
          .then((data) => {
            const tbody = document.getElementById("data");

            if (data.length === 0 && current_page > 0) {
              current_page--;
              return;
            }

            if (data.length === 0) {
              tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; padding: 48px; color: var(--text-muted)">Hali urinishlar mavjud emas.</td></tr>`;
              return;
            }

            tbody.innerHTML = data
              .map(
                (item) => `
                <tr>
                  <td style="text-align: center; color: var(--text-muted); font-weight: 500">#${item.attempt_id}</td>
                  <td>
                    <div style="font-weight: 600; font-size: 13px">${item.full_name || item.username}</div>
                    <div style="font-size: 11px; color: var(--text-muted)">@${item.username}</div>
                  </td>
                  <td>
                    <a href="/contest/${contest_id}/problem?task_id=${item.task_id}" style="font-weight: 500">#${item.task_id}</a>
                  </td>
                  <td style="font-size: 11px; color: var(--text-muted)">${item.language_used}</td>
                  <td>
                    <span class="badge ${item.status_code == 1 ? "badge-success" : "badge-error"}">
                      ${item.status_message}
                    </span>
                  </td>
                  <td style="text-align: right; font-family: var(--font-mono); font-size: 12px">${item.time_ms}ms</td>
                  <td style="text-align: right; font-family: var(--font-mono); font-size: 12px">${Math.round(item.memory_kb / 1024)}MB</td>
                </tr>
              `
              )
              .join("");
          })
          .catch(() => {
            document.getElementById("data").innerHTML = `<tr><td colspan="7" style="text-align: center; padding: 48px; color: var(--text-muted)">Ma'lumotlarni yuklashda xatolik.</td></tr>`;
          });
      }

      loadAttempts();
      setInterval(loadAttempts, 5000);
    </script>
  </body>
</html>
