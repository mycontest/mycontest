<!DOCTYPE html>
<html lang="uz">
  <head>
    <title><%= contest.name %> — mycontest.dev</title>
    <%- include("../components/head.ejs") %>
  </head>
  <body>
    <%- include("../components/navbar.ejs") %>

    <main style="padding: 16px 0 32px">
      <div class="container">
        <%- include("topbar.ejs") %>

        <div class="row g-3">
          <!-- Main Content -->
          <div class="col-lg-9">
            <!-- Contest Header & Description -->
            <div class="card" style="padding: 16px; margin-bottom: 12px">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px">
                <h1 style="font-size: 15px; font-weight: 600; margin: 0"><%= contest.name %></h1>
                <div class="flex items-center gap-2">
                  <% if (contest.event === 'Faol') { %>
                  <span style="background: #10b981; color: white; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600">Faol</span>
                  <% } else if (contest.event === 'Tugagan') { %>
                  <span style="background: #6b7280; color: white; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600">Tugagan</span>
                  <% } else { %>
                  <span style="background: #3b82f6; color: white; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600">Boshlanmadi</span>
                  <% } %>
                </div>
              </div>
              <div class="prose" style="font-size: 12px"><%- contest.content %></div>

              <% if (!is_participant && !is_admin && contest.contest_type !== 'private') { %>
              <div style="margin-top: 20px; text-align: center; padding: 20px; background: var(--bg-tertiary); border-radius: 8px">
                <h4 style="font-size: 14px; margin-bottom: 10px">Musobaqada qatnashish</h4>
                <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 15px">Masalalarni ko'rish va yechim yuborish uchun musobaqaga qo'shiling.</p>
                <form action="/contest/<%= contest.contest_id %>/join" method="POST">
                  <button type="submit" class="btn btn-primary btn-md">Qo'shilish</button>
                </form>
              </div>
              <% } else if (!is_participant && !is_admin && contest.contest_type === 'private') { %>
              <div style="margin-top: 20px; text-align: center; padding: 20px; background: var(--bg-error-light); border-radius: 8px">
                <h4 style="font-size: 14px; margin-bottom: 10px; color: var(--error)">Yopiq musobaqa</h4>
                <p style="font-size: 12px; color: var(--text-muted)">Ushbu musobaqada qatnashish faqat taklifnoma orqali mumkin.</p>
              </div>
              <% } %>
            </div>

            <!-- Contest Rules -->
            <div class="card" style="padding: 16px">
              <h3 style="font-size: 14px; font-weight: 600; margin: 0 0 12px 0">Contest Qoidalari</h3>
              <div style="font-size: 12px; line-height: 1.6; color: var(--text-secondary)">
                <ul style="margin: 0; padding-left: 20px">
                  <li style="margin-bottom: 6px">Har bir masala uchun cheksiz urinish imkoniyati mavjud</li>
                  <li style="margin-bottom: 6px">Noto'g'ri yechimlar uchun 10 daqiqa jarima qo'shiladi</li>
                  <li style="margin-bottom: 6px">Natijalar real vaqtda yangilanadi</li>
                  <li style="margin-bottom: 6px">Plagiat tekshiruvi amalga oshiriladi</li>
                  <li style="margin-bottom: 6px">Faqat ruxsat etilgan dasturlash tillari ishlatiladi</li>
                  <li style="margin-bottom: 6px">Vaqt va xotira chegaralariga rioya qiling</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Time Info -->
          <div class="col-lg-3">
            <div class="card" style="padding: 14px">
              <div style="font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 10px">Vaqt</div>
              <div style="font-size: 12px; display: flex; flex-direction: column; gap: 6px">
                <div>
                  <div class="text-muted" style="font-size: 10px">Boshlanish</div>
                  <div style="font-weight: 500"><%= new Date(contest.start_date).toLocaleDateString('uz-UZ', { day: 'numeric', month: 'short', year: 'numeric' }) %>, <%= new Date(contest.start_date).toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit' }) %></div>
                </div>
                <div>
                  <div class="text-muted" style="font-size: 10px">Tugash</div>
                  <div style="font-weight: 500"><%= new Date(contest.end_date).toLocaleDateString('uz-UZ', { day: 'numeric', month: 'short', year: 'numeric' }) %>, <%= new Date(contest.end_date).toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit' }) %></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
