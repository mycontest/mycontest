<style>
  .ql-editor {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
  }
  .ql-toolbar {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
</style>

<div id="<%= id %>"><%- value %></div>
<input type="hidden" name="<%= id %>" value="<%= value %>" />

<script>
  window.addEventListener("load", function () {
    if (!window.quill) window.quill = {};

    var container = document.querySelector("#<%= id %>");
    if (container) {
      window.quill["<%= id %>"] = new Quill("#<%= id %>", {
        modules: {
          toolbar: [
            ["bold", "italic", "underline", "strike"],
            ["blockquote", "code-block"],
            ["link", "image", "video", "formula"],
            [{ header: 1 }, { header: 2 }],
            [{ list: "ordered" }, { list: "bullet" }, { list: "check" }],
            [{ script: "sub" }, { script: "super" }],
            [{ indent: "-1" }, { indent: "+1" }],
            [{ direction: "rtl" }],
            [{ size: ["small", false, "large", "huge"] }],
            [{ header: [1, 2, 3, 4, 5, 6, false] }],
            [{ color: [] }, { background: [] }],
            [{ font: [] }],
            [{ align: [] }],
            ["clean"],
          ],
        },
        theme: "snow",
      });

      // Set default font family
      var toolbar = window.quill["<%= id %>"].getModule("toolbar");
      if (toolbar && toolbar.container) {
        var quillFont = toolbar.container.querySelector(".ql-font .ql-picker-label");
        if (quillFont) {
          window.quill["<%= id %>"].format("font", "Inter, sans-serif");
        }
      }

      function syncQuillToTextarea() {
        var textarea = document.querySelector('input[name="<%= id %>"]');
        var content = window.quill["<%= id %>"].root.innerHTML;
        textarea.value = content;
      }

      window.quill["<%= id %>"].on("text-change", syncQuillToTextarea);

      // Initial sync
      syncQuillToTextarea();
    }
  });
</script>
