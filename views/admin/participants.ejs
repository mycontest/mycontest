<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Ishtirokchilar — <%= contest.name %></title>
    <%- include("../components/head.ejs") %>
  </head>
  <body style="background: var(--bg-secondary)">
    <%- include("../components/navbar.ejs") %>

    <main style="padding: 16px 0 32px">
      <div class="container">
        <div class="row g-4">
          <%- include("./sidebar.ejs") %>

          <div class="col-lg-9">
            <div class="mb-5">
              <h1 class="mb-1">Ishtirokchilar — <%= contest.name %></h1>
              <p class="text-muted">Private contest uchun ishtirokchilarni boshqarish.</p>
            </div>

            <!-- Add Participant Form -->
            <div class="card mb-4">
              <h3 style="font-size: 14px; margin-bottom: 16px">Ishtirokchi qo'shish</h3>
              <form action="/admin/participants/add" method="POST" class="flex gap-2">
                <input type="hidden" name="contest_id" value="<%= contest_id %>" />
                <select name="user_id" class="form-control form-control-sm" style="max-width: 300px" required>
                  <option value="">Foydalanuvchini tanlang</option>
                  <% all_users.forEach(user => { %>
                  <option value="<%= user.user_id %>"><%= user.username %> — <%= user.full_name %></option>
                  <% }); %>
                </select>
                <button type="submit" class="btn btn-primary btn-md">
                  <i class="bi bi-plus-lg"></i>
                  Qo'shish
                </button>
              </form>
            </div>

            <!-- Participants List -->
            <div class="card" style="padding: 0; overflow: hidden">
              <div class="card-header" style="margin: 0; border-radius: 0">
                <span class="card-title">Ro'yxat (<%= participants.length %>)</span>
              </div>

              <table>
                <thead>
                  <tr>
                    <th style="width: 60px">#</th>
                    <th>Username</th>
                    <th>To'liq ism</th>
                    <th>Email</th>
                    <th style="width: 140px; text-align: right">Qo'shilgan</th>
                    <th style="width: 80px; text-align: right">Amallar</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(participants && participants.length > 0) { %> <% participants.forEach((p, i) => { %>
                  <tr>
                    <td style="color: var(--text-muted)"><%= i + 1 %></td>
                    <td style="font-weight: 500"><%= p.username %></td>
                    <td><%= p.full_name %></td>
                    <td style="font-size: 12px"><%= p.email || '-' %></td>
                    <td style="text-align: right; font-size: 12px" class="text-muted"><%= new Date(p.created_dt).toLocaleDateString() %></td>
                    <td style="text-align: right">
                      <a href="/admin/participants/remove?contest_id=<%= contest_id %>&user_id=<%= p.user_id %>" class="btn btn-ghost btn-md btn-icon" style="color: var(--error)" onclick='return confirm("Ishtirokchini o&apos;chirmoqchimisiz?")'>
                        <i class="bi bi-trash"></i>
                      </a>
                    </td>
                  </tr>
                  <% }); %> <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 32px" class="text-muted">Ishtirokchilar hali qo'shilmagan.</td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <div class="mt-4">
              <a href="/admin/contestadd?contest_id=<%= contest_id %>" class="btn">
                <i class="bi bi-arrow-left"></i>
                Contestga qaytish
              </a>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
