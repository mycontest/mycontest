<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Email Logs — Admin Panel</title>
    <%- include("../components/head.ejs") %>
  </head>
  <body style="background: var(--bg-secondary)">
    <%- include("../components/navbar.ejs") %>

    <main style="padding: 16px 0 32px">
      <div class="container">
        <div class="row g-4">
          <%- include("./sidebar.ejs") %>

          <div class="col-lg-9">
            <div class="mb-5">
              <h1 class="mb-1">Email Logs</h1>
              <p class="text-muted">Yuborilgan emaillar tarixi.</p>
            </div>

            <div class="card" style="padding: 0; overflow: hidden">
              <table>
                <thead>
                  <tr>
                    <th style="width: 60px">ID</th>
                    <th>Qabul qiluvchi</th>
                    <th style="width: 120px">Template</th>
                    <th style="width: 100px; text-align: center">Holat</th>
                    <th>Xatolik</th>
                    <th style="width: 140px; text-align: right">Vaqt</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(logs && logs.length > 0) { %> <% logs.forEach(log => { %>
                  <tr>
                    <td style="font-weight: 600; color: var(--text-muted)">#<%= log.log_id %></td>
                    <td>
                      <div style="font-weight: 500"><%= log.recipient_email %></div>
                    </td>
                    <td><span class="badge"><%= log.template_name %></span></td>
                    <td style="text-align: center">
                      <% if(log.status === 'sent') { %>
                      <span class="badge badge-success">Yuborildi</span>
                      <% } else { %>
                      <span class="badge badge-error">Xatolik</span>
                      <% } %>
                    </td>
                    <td style="font-size: 11px; color: var(--error); max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis" title="<%= log.error_message %>"><%= log.error_message || '-' %></td>
                    <td style="text-align: right; font-size: 12px" class="text-muted"><%= new Date(log.created_dt).toLocaleString() %></td>
                  </tr>
                  <% }); %> <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 32px" class="text-muted">Logs topilmadi.</td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Pagination -->
            <% if(count > 1) { %>
            <div class="flex justify-center gap-2 mt-4">
              <% for(let i = 0; i < count; i++) { %>
              <a href="/admin/emaillogs?page=<%= i %>" class="btn <%= page == i ? 'btn-primary' : '' %> btn-md"> <%= i + 1 %> </a>
              <% } %>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
