<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Admin Dashboard — mycontest.dev</title>
    <%- include("../components/head.ejs") %>
  </head>
  <body style="background: var(--bg-secondary)">
    <%- include("../components/navbar.ejs") %>

    <main style="padding: 16px 0 32px">
      <div class="container">
        <div class="row g-4">
          <%- include("./sidebar.ejs") %>

          <div class="col-lg-9">
            <!-- Page Header -->
            <div class="mb-5">
              <h1 class="mb-1">Admin Dashboard</h1>
              <p class="text-muted">Platforma holati va boshqaruv paneli.</p>
            </div>

            <!-- Stats Cards -->
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <div class="card stat-card h-100">
                  <div class="stat-label">Faol Musobaqalar</div>
                  <div class="flex items-end justify-between">
                    <span class="stat-value"><%= active_contests %></span>
                    <span class="badge badge-success badge-dot">Live</span>
                  </div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card stat-card h-100">
                  <div class="stat-label">Jami Masalalar</div>
                  <div class="flex items-end justify-between">
                    <span class="stat-value"><%= problems_count %></span>
                    <span class="text-muted text-sm">Total</span>
                  </div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card stat-card h-100">
                  <div class="stat-label">Foydalanuvchilar</div>
                  <div class="flex items-end justify-between">
                    <span class="stat-value"><%= users_count %></span>
                    <span class="text-muted text-sm">Active</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="card mb-4" style="padding: 0; overflow: hidden">
              <div class="card-header" style="margin: 0; border-radius: 0; border-bottom: 1px solid var(--border-light); padding: 12px 16px">
                <span class="card-title">Tezkor Harakatlar</span>
              </div>
              <div class="p-3">
                <div class="row g-3">
                  <div class="col-md-6">
                    <a href="/admin/contestadd" class="card card-interactive h-100" style="padding: 12px; border: 1px solid var(--border-light)">
                      <div class="flex items-center gap-3">
                        <div style="width: 36px; height: 36px; background: var(--success-bg); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0">
                          <i class="bi bi-calendar-plus" style="font-size: 16px; color: var(--success)"></i>
                        </div>
                        <div>
                          <h4 style="margin: 0; font-size: 13px; font-weight: 600">Musobaqa yaratish</h4>
                          <p class="text-muted text-xs m-0">Yangi musobaqa qo'shish.</p>
                        </div>
                      </div>
                    </a>
                  </div>
                  <div class="col-md-6">
                    <a href="/admin/problemsadd" class="card card-interactive h-100" style="padding: 12px; border: 1px solid var(--border-light)">
                      <div class="flex items-center gap-3">
                        <div style="width: 36px; height: 36px; background: var(--primary-light); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0">
                          <i class="bi bi-plus-lg" style="font-size: 16px; color: var(--primary)"></i>
                        </div>
                        <div>
                          <h4 style="margin: 0; font-size: 13px; font-weight: 600">Masala qo'shish</h4>
                          <p class="text-muted text-xs m-0">Yangi masala yaratish.</p>
                        </div>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
