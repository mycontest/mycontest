<!DOCTYPE html>
<html lang="uz">
  <head>
    <title>Musobaqalar — Admin Panel</title>
    <%- include("../components/head.ejs") %>
  </head>
  <body style="background: var(--bg-secondary)">
    <%- include("../components/navbar.ejs") %>

    <main style="padding: 16px 0 32px">
      <div class="container">
        <div class="row g-4">
          <%- include("./sidebar.ejs") %>

          <div class="col-lg-9">
            <div class="flex justify-between items-center mb-5">
              <div>
                <h1 class="mb-1">Musobaqalar</h1>
                <p class="text-muted">Barcha musobaqalar ro'yxati.</p>
              </div>
              <a href="/admin/contestadd" class="btn btn-primary btn-md">
                <i class="bi bi-plus-lg"></i>
                Yangi qo'shish
              </a>
            </div>

            <div class="table-wrapper">
              <table>
                <thead>
                  <tr>
                    <th style="width: 70px">ID</th>
                    <th>Nomi</th>
                    <th style="width: 100px; text-align: center">Holati</th>
                    <th style="width: 160px">Boshlanish</th>
                    <th style="width: 160px">Tugash</th>
                    <th style="width: 80px; text-align: right">Amal</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(contests && contests.length > 0) { %> <% for(var i=0; i < contests.length; i++) { %>
                  <tr>
                    <td style="font-weight: 600; color: var(--text-muted)">#<%= contests[i].contest_id %></td>
                    <td style="font-weight: 500"><%= contests[i].name %></td>
                    <td style="text-align: center">
                      <% if(contests[i].event === 'live') { %>
                      <span class="badge badge-success badge-dot">Live</span>
                      <% } else if(contests[i].event === 'upcoming') { %>
                      <span class="badge badge-warning">Kutilmoqda</span>
                      <% } else { %>
                      <span class="badge">Tugagan</span>
                      <% } %>
                    </td>
                    <td style="font-size: 12px"><%= contests[i].start %></td>
                    <td style="font-size: 12px"><%= contests[i].end %></td>
                    <td style="text-align: right">
                      <div class="flex justify-end gap-1">
                        <a href="/admin/contestadd?contest_id=<%= contests[i].contest_id %>" class="btn btn-ghost btn-md btn-icon">
                          <i class="bi bi-pencil"></i>
                        </a>
                        <a href="/admin/delcontest?contest_id=<%= contests[i].contest_id %>" class="btn btn-ghost btn-md btn-icon" onclick="return confirm('Rostdan ham o\'chirmoqchimisiz?')" style="color: var(--error)">
                          <i class="bi bi-trash"></i>
                        </a>
                      </div>
                    </td>
                  </tr>
                  <% } %> <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 48px" class="text-muted">Musobaqalar topilmadi.</td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <% if (count > 1) { %>
            <div class="flex justify-center mt-4">
              <nav class="flex gap-1">
                <% for(var i=0; i < count; i++) { %>
                <a href="?page=<%= i %>" class="btn btn-md <%= i == page ? 'btn-primary' : '' %>" style="min-width: 32px"> <%= i + 1 %> </a>
                <% } %>
              </nav>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>

    <%- include("../components/footer.ejs") %>
  </body>
</html>
