<nav class="navbar">
  <div class="container navbar-inner">
    <div class="flex items-center">
      <a href="/" class="nav-brand">
        <div class="nav-brand-icon">
          <i class="bi bi-code-slash"></i>
        </div>
        <span>mycontest</span>
      </a>
    </div>

    <div class="nav-actions">
      <% if(user) { %>
      <div class="dropdown">
        <button class="btn btn-ghost btn-md dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-person-circle"></i>
          <span class="hidden-mobile"><%= user.username %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
          <% if(user.role === 'admin') { %>
          <li>
            <a class="dropdown-item" href="/admin">
              <i class="bi bi-grid text-muted"></i>
              Admin Panel
            </a>
          </li>
          <li><hr class="dropdown-divider" /></li>
          <% } %>
          <li>
            <a class="dropdown-item" href="/logout" style="color: var(--error)">
              <i class="bi bi-box-arrow-right"></i>
              Chiqish
            </a>
          </li>
        </ul>
      </div>
      <% } else { %>
      <a href="/sign-in" class="btn btn-ghost btn-md">Kirish</a>
      <a href="/sign-up" class="btn btn-primary btn-md">Ro'yxatdan o'tish</a>
      <% } %>
    </div>
  </div>
</nav>

<!-- Flash Messages -->
<% if (success && success.length > 0) { %>
<div class="container" style="margin-top: 16px">
  <div class="alert alert-success alert-dismissible fade show" role="alert" style="font-size: 13px">
    <i class="bi bi-check-circle-fill"></i>
    <%= success[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
<% } %> <% if (error && error.length > 0) { %>
<div class="container" style="margin-top: 16px">
  <div class="alert alert-danger alert-dismissible fade show" role="alert" style="font-size: 13px">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
<% } %>
