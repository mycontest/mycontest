# ==========================================
# Copy this to .env and update values
# ==========================================

# ==========================================
# APPLICATION
# ==========================================
PORT=3000
DOMAIN=localhost:3000
SECRET=change-this-to-random-secret
LIMIT=50mb

# ==========================================
# DATABASE (MySQL)
# ==========================================
# Docker: mysql | Local: localhost
MYSQL_HOST=mysql
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=my_contest

# ==========================================
# REDIS
# ==========================================
# Docker: redis | Local: localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-password

# ==========================================
# ENVIRONMENT
# ==========================================
NODE_ENV=development

# ==========================================
# NOTES
# ==========================================
# - Change all passwords in production
# - Generate strong SECRET (32+ chars)
# - Never commit .env to git
# ==========================================